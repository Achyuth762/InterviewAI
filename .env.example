# Environment Variables Template
# Copy this file to .env and fill in your actual values

# Server Configuration
NODE_ENV=development
PORT=5000

# MongoDB Connection
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?appName=YourApp

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# NVIDIA NIM API Configuration (Primary AI Provider)
# Get your API key from https://build.nvidia.com/
NVIDIA_API_KEY=your_nvidia_nim_api_key_here
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_AI_MODEL=meta/llama-3.1-405b-instruct
NVIDIA_AI_MODELS=meta/llama-3.1-405b-instruct,mistralai/mistral-large

# Fallback AI Provider (Groq - used if NVIDIA NIM fails)
# Get your API key from https://console.groq.com/keys
FALLBACK_API_KEY=your_groq_api_key_here
FALLBACK_AI_MODEL=llama-3.1-8b-instant
FALLBACK_AI_MODELS=llama-3.1-8b-instant,llama-3.3-70b-versatile

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here

# Client Configuration (for CORS)
CLIENT_URL=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Frontend Configuration
# Note: Also set this in client/.env
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
